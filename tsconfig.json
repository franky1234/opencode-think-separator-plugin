{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "declaration": true,
        "declarationDir": "./types",
        "outDir": "./types",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "types/**/*.d.ts"],
    "exclude": ["node_modules", "test"]
}