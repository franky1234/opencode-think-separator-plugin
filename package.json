{
    "name": "opencode-think-separator-plugin",
    "version": "0.3.0",
    "description": "Opencode TUI plugin that visually separates model reasoning blocks from responses. Agnostic to provider (Anthropic, OpenAI, Google, MiniMax).",
    "type": "module",
    "main": "src/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": "./src/index.js",
        "./core": "./src/core.js",
        "./stream": "./src/stream.js",
        "./render": "./src/render.js"
    },
    "bin": {
        "opencode-think-separator-plugin-install": "bin/install.sh"
    },
    "files": [
        "src/",
        "types/",
        "bin/install.sh",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test test/*.test.js",
        "test:watch": "node --test --watch test/*.test.js",
        "lint": "biome check src test",
        "check:types": "tsc --noEmit",
        "check:fix": "npm run format && npm run lint && npm run check:types && npm test",
        "format": "npx prettier --write \"src/**/*.js\" \"test/**/*.js\"",
        "format:check": "npx prettier --check \"src/**/*.js\" \"test/**/*.js\"",
        "prettier:fix": "npx prettier --write \"src/**/*.js\" \"test/**/*.js\"",
        "prepublishOnly": "node --check src/index.js && npm test",
        "harness:check": "bash .harness/add-skills.sh",
        "harness:regen": "bash .harness/generate-agents.sh --force --no-backup",
        "harness:dev": "bash bin/harness-load.sh"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "prettier": "^3.5.2",
        "typescript": "^5.6.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "tui",
        "reasoning",
        "thinking",
        "anthropic",
        "openai",
        "google",
        "minimax",
        "plugin",
        "opencode-ai"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/franky1234/opencode-think-separator-plugin.git"
    },
    "bugs": {
        "url": "https://github.com/franky1234/opencode-think-separator-plugin/issues"
    },
    "homepage": "https://github.com/franky1234/opencode-think-separator-plugin#readme"
}
