{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        [
            "opencode-think-separator-plugin",
            {
                "label": "Reasoning",
                "style": "markdown",
                "models": {
                    "anthropic/claude-3.7-sonnet": {
                        "style": "details",
                        "label": "Deep Thinking"
                    },
                    "openai/o3-mini": {
                        "style": "compact",
                        "maxLines": 8
                    },
                    "deepseek/deepseek-r1": {
                        "style": "raw",
                        "label": "Chain-of-Thought"
                    },
                    "google/gemini-2.5-pro": {
                        "label": "Gemini Reasoning"
                    }
                }
            }
        ]
    ]
}
